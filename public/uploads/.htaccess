Options -Indexes -ExecCGI

<IfModule mod_mime.c>
  RemoveHandler .php .php3 .php4 .php5 .php7 .php8 .phtml .phar .cgi .pl .py .rb .sh
  RemoveType .php .php3 .php4 .php5 .php7 .php8 .phtml .phar .cgi .pl .py .rb .sh
  AddType image/jpeg .jpg .jpeg
  AddType audio/mpeg .mp3
</IfModule>

<IfModule mod_php.c>
  php_flag engine off
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Deny hidden files, traversal-like names, double extensions, and executable payloads.
  RewriteRule "(^|/)\." - [F,L]
  RewriteRule "\.\.(?:/|$)" - [F,L]
  RewriteRule "\.(?:php[0-9]?|phtml|phar|sh|cgi|pl|py|rb|js|html?|svg|xml)(?:\.|$)" - [F,L,NC]

  # Exact public whitelist: only these paths and media types may be served.
  RewriteRule ^(?:covers|couples|gallery)/[A-Za-z0-9_-]+\.jpe?g$ - [END,NC]
  RewriteRule ^music/[A-Za-z0-9_-]+\.mp3$ - [END,NC]
  RewriteRule ^ - [F,L]
</IfModule>

<FilesMatch "\.(?:php[0-9]?|phtml|phar|sh|cgi|pl|py|rb|js|html?|svg|xml|htaccess|env)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Content-Security-Policy "default-src 'none'; sandbox"
  Header always set Cross-Origin-Resource-Policy "same-site"
  Header set Cache-Control "public, max-age=31536000, immutable"
</IfModule>
