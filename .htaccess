Options -Indexes -MultiViews
ServerSignature Off

<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self), payment=()"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; img-src 'self' data: blob: https://maps.googleapis.com https://*.googleusercontent.com; media-src 'self' blob: https://*.soundcloud.com; connect-src 'self' https://*.googleapis.com https://*.soundcloud.com; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com https://w.soundcloud.com https://www.google.com https://maps.google.com; script-src 'self' https://www.youtube.com https://w.soundcloud.com; style-src 'self' 'unsafe-inline'"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Block dotfiles and hidden directories, while Apache may still read .htaccess.
  RewriteRule "(^|/)\." - [F,L]

  # Never expose source, configuration, database, logs, or dependencies.
  RewriteRule ^(?:app|database|docs|tests|vendor|node_modules)(?:/|$) - [F,L,NC]
  RewriteRule \.(?:env|ini|log|sql|sqlite|bak|dist|yml|yaml|lock|md)$ - [F,L,NC]

  # Preserve the REST front controller and physical public assets.
  RewriteRule ^api/?$ api.php [END,QSA]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [END]

  # History API fallback for /, /login, /admin, /studio and public slugs.
  RewriteRule ^ index.html [END]
</IfModule>

<FilesMatch "^(?:\.env|\.git|\.htaccess|composer\.(?:json|lock)|package(?:-lock)?\.json|schema\.sql)$">
  Require all denied
</FilesMatch>

<FilesMatch "\.(?:php~|phar|phtml|inc|sh|cgi|pl|py|rb|conf|config)$">
  Require all denied
</FilesMatch>

# api.php is the only publicly executable PHP file.
<Files "api.php">
  Require all granted
</Files>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType audio/mpeg "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(?:css|js|jpg|jpeg|mp3|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(?:index\.html|api\.php)$">
    Header set Cache-Control "no-store, max-age=0"
  </FilesMatch>
</IfModule>
